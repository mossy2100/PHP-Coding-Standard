{
    "name": "mossy2100/coding-standard",
    "description": "The Jumbo Coding Standard for PHP_CodeSniffer: a PERCS31 ruleset for PER Coding Style 3.1, and a Jumbo ruleset that adds lowerCamelCase naming and modern PHP 8.4+ rules.",
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "keywords": [
        "php",
        "phpcs",
        "codesniffer",
        "coding-standard",
        "psr-12",
        "per-coding-style",
        "linting",
        "code-style"
    ],
    "authors": [
        {
            "name": "Shaun Moss",
            "email": "mossy2100@gmail.com"
        }
    ],
    "homepage": "https://github.com/mossy2100/PHP-Coding-Standard",
    "support": {
        "issues": "https://github.com/mossy2100/PHP-Coding-Standard/issues",
        "source": "https://github.com/mossy2100/PHP-Coding-Standard"
    },
    "require": {
        "php": "^8.4",
        "squizlabs/php_codesniffer": "^4.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "slevomat/coding-standard": "^8.27",
        "phpcsstandards/phpcsextra": "^1.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "fix": "vendor/bin/phpcbf -vp",
        "check": "vendor/bin/phpcs -sv --colors",
        "report": "vendor/bin/phpcs -q --report=summary",
        "analyze": "scripts/analyze",
        "test": "vendor/bin/phpunit",
        "quality": [
            "@fix",
            "@check",
            "@analyze",
            "@test"
        ]
    },
    "extra": {
        "phpcodesniffer-search-depth": 3
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.4.0"
        }
    }
}
