<?xml version="1.0"?>
<ruleset name="Jumbo">
    <description>Coding standard created for the PHP packages by Shaun Moss.</description>

    <!-- Paths to check -->
    <file>src</file>

    <!-- Use Jumbo Coding Standard (includes PSR12 + additional rules) -->
    <rule ref="Jumbo"/>

    <exclude-pattern>*/Tests/*.inc</exclude-pattern>
    <exclude-pattern>*/Tests/*.inc.fixed</exclude-pattern>
    <exclude-pattern>*/ScopeIndentSniff.php</exclude-pattern>
</ruleset>
