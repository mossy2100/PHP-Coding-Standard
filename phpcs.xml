<?xml version="1.0"?>
<ruleset name="Mossy2100 PHP Coding Standard">
    <description>Coding standard for the Mossy2100 packages by Shaun Moss.</description>

    <!-- Paths to check -->
    <file>src</file>

    <!-- Use Mossy2100 PHP Coding Standard (includes PSR12 + additional rules) -->
    <rule ref="Mossy2100"/>

    <exclude-pattern>*/Tests/*.inc</exclude-pattern>
    <exclude-pattern>*/Tests/*.inc.fixed</exclude-pattern>
    <exclude-pattern>*/ScopeIndentSniff.php</exclude-pattern>

</ruleset>
