<?php

// The values the Jumbo ruleset sets.
// phpcs:set Jumbo.Classes.EmptyLinesAroundClassBraces linesCountAfterOpeningBrace 0
// phpcs:set Jumbo.Classes.EmptyLinesAroundClassBraces linesCountBeforeClosingBrace 0

// === VALID: an empty body on one line ===

final class EmptyException extends Exception {}

interface EmptyInterface {}

final class Normal
{
    public int $a = 1;
}

// === INVALID: the parent's checks still run ===

final class BlankAfterOpening
{
    public int $a = 1;
}

final class BlankBeforeClosing
{
    public int $a = 1;
}

function anonymous(): object
{
    return new class {};
}
