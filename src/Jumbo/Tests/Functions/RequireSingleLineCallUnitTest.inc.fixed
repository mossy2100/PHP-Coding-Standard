<?php

// === VALID ===

consume(new class {
    public int $y = 2;

    public string $name = 'x';
});

$wrapper = new Wrapper(new class {
    public int $y = 2;
});

consume(static function (): int {
    return 1;
});

single(1, 2);

// === INVALID: the parent's checks still run ===

short(1, 2);

$object = new Short(1);

// A match argument is skipped, as with an anonymous class.
short(match ($x) {
    1 => 2,
    default => 3,
});

short(
    match ($x) {
        1 => 2,
        default => 3,
    },
);

short(
    1,
    match ($x) {
        1 => 2,
        default => 3,
    },
);
