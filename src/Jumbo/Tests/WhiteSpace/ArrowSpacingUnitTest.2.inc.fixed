<?php

// phpcs:set Jumbo.WhiteSpace.ArrowSpacing checkArray true
// phpcs:set Jumbo.WhiteSpace.ArrowSpacing checkYield true

// Correct spacing.
$single = ['a' => 1, 'b' => 2];
$multi = [
    'name' => 1,
    'callback' => static function (): int {
        return 1;
    },
    'after' => 2,
];
$long = array('k' => 1);
['p' => $p] = $pair;
function correct(): iterable
{
    yield 'a' => 1;
    $sent = yield 'b' => 2;
    yield 'c'
        => 3;
}

// No spaces, and two spaces, in a single-line array.
$single = ['a' => 1, 'b' => 2];

// Aligned arrows in a multi-line array, and an element after a closure.
$multi = [
    'name' => 1,
    'callback' => static function (): int {
        return 1;
    },
    'after' => 2,
];

// A long array, and destructuring.
$long = array('k' => 1);
['p' => $p] = $pair;

// A yield.
function wrong(): iterable
{
    yield 'a' => 1;
}

// Not checked: a foreach's arrow.
foreach ($pairs as $key=>$value) {
    echo $key, $value;
}

