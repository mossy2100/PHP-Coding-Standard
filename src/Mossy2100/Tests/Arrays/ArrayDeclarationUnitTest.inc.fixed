<?php

// Single-line arrays are fine.
$colors = ['red', 'green', 'blue'];
$user = ['name' => 'John', 'email' => 'john@example.com'];

// A list that fits.
$colors = ['red', 'green', 'blue'];

// An associative array that fits, with aligned arrows.
$user = ['name' => 'John', 'email' => 'john@example.com'];

// An empty array.
$empty = [];

// Destructuring.
[$first, $second] = $pair;

// Nested arrays that fit: only the outer array is reported.
$matrix = [[1, 2], [3, 4]];

// The outer array is too long, but the nested one fits.
$config = [
    'description' => 'Stock levels for every warehouse, refreshed nightly from the supplier feed for reporting.',
    'limits' => ['min' => 0, 'max' => 100],
];

// A call with trailing commas inside the array.
$results = [strtoupper('red'), strtolower('GREEN')];

// An array passed to a call, followed by more arguments.
$process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);

// Fits up to the closing bracket, but not with the rest of the line.
$process = proc_open($command, [
    1 => ['pipe', 'w'],
    2 => ['pipe', 'w'],
], $pipes, $workingDirectory, $environmentVariables, ['bypass_shell' => true, 'suppress_errors' => true]);

// Too long for one line.
$words = [
    'The quick brown fox jumps over the lazy dog.',
    'Pack my box with five dozen liquor jugs, please.',
    'How vexingly quick daft zebras jump!',
];

// Contains a comment.
$colors = [
    'red', // Warm.
    'blue',
];

// Contains a closure.
$callbacks = [
    static function (): int {
        return 1;
    },
];

// Contains an arrow function, which is fine.
$callbacks = [static fn (int $x): int => $x * 2];

// A wrapped method chain.
$values = [$a->b()?->c()::d()];

// Contains a match expression.
$labels = [
    match ($size) {
        1 => 'one',
        default => 'many',
    },
];

// Contains a heredoc.
$texts = [
    <<<EOT
    Hello
    EOT,
];

// Contains a multi-line string.
$texts = [
    'Hello
    world',
];

// Two arrays that each fit, but not once joined: only the first is collapsed.
$defaults = ['alpha' => 'first value here', 'beta' => 'second value here'] + [
    'gamma' => 'third value here',
    'delta' => 'fourth value here',
];

// A too-long array, then one that fits on the joined line.
$defaults = [
    'alpha' => 'a first value that is long enough to keep this array from fitting on one line',
    'beta' => 'second value',
] + ['gamma' => 'third value'];

// A configured maximum line length.
// phpcs:set Mossy2100.Arrays.ArrayDeclaration maxLineLength 40
$colors = [
    'red',
    'green',
    'blue',
    'yellow',
];
$colors = ['red', 'green'];
