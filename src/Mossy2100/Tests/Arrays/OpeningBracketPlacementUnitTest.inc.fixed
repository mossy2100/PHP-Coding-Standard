<?php

// === VALID ===

$single = [1, 2];

$multi = [
    1,
    2,
];

$nested = [
    [
        1,
        2,
    ],
    [
        3,
    ],
];

[
    $first,
    $second,
] = pair();

foo([
    1,
    2,
]);

// === INVALID ===

foo([
        1,
        2,
    ]);

foo([
        1,
    ]);

$map = [
    'key' => [
            1,
        ],
];

return [
        1,
    ];

bar(
    $a,
    [
        1,
    ],
);

bar(
    [
        1,
    ],
    $b,
);

baz( // Why.
    [
        1,
    ],
);
