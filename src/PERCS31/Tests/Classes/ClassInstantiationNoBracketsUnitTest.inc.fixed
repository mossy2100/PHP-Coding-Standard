<?php

// === VALID ===

$a = new Foo()->bar();
$b = (new Foo() ?: new Bar())->baz();
$c = ($condition ? new Foo() : new Bar())->baz();
$d = new self(new Foo())->bar();
$e = foo(new Foo())->bar();
$f = (new Foo)->bar();
$g = (new Foo() . 'x');
$h = (new Foo());

// === INVALID ===

$i = new Foo()->bar();
$j = new Foo()?->bar();
$k = new Foo()::CONSTANT;
$l = new \Vendor\Foo()->bar();
$m = new $class()->bar();
$n = new class {
    public int $x = 1;
}->x;

// A comment between the parentheses and the expression (not fixable).
$o = (/* c1 */ new Foo() /* c2 */)->bar();
$p = (new Foo() // Why.
)->bar();

// A keyword straight before the parentheses, where the fix puts a space in their place.
function keywords()
{
    echo new Foo()->bar();
    print new Foo()->bar();
    yield new Foo()->bar();
    throw new Factory()->make();
    return new Foo()->bar();
}

// The parentheses after clone hold its arguments, so they stay.
$copy = clone(new Foo())->bar;

// A call through an array, a string or an expression. The parentheses hold its arguments, so they stay.
$made = [$factory, 'make'](new Foo())->bar();
$made = 'make'(new Foo())->bar();
$made = "make"(new Foo())->bar();
$made = $factories['foo'](new Foo())->bar();
$made = $factory->{$method}(new Foo())->bar();
$made = (fn($x) => $x)(new Foo())->bar();
