<?php

// A global constant isn't checked.
const  GLOBAL_LIMIT = 1;

final class Valid
{
    public const LIMIT = 1;
    public const int TYPED = 1;
    final protected const ?string NULLABLE = null;
    private const int|string UNION = 1;
    const BARE = 1;
    public const A = 1;
    public const B = 2;
}

final class Invalid
{
    public const LIMIT = 1;
    public const int TYPED = 1;
    public const int SPACED = 1;
    public const ?string BOTH = null;
    public const WRAPPED = 1;
    public const int TYPE_WRAPPED = 1;
    private const int|string UNION = 1;
    public const /* A single space each side of a comment passes. */ COMMENTED = 1;
}

interface HasConstant
{
    public const int LIMIT = 1;
}

enum Suit
{
    case Hearts;

    public const Suit Wild = self::Hearts;
}

// An enum case: two spaces after case, and a line break. A switch's case isn't checked here.
enum Rank: string
{
    case Ace = 'A';
    case King = 'K';
    case Queen = 'Q';
}

switch ($rank) {
    case  Rank::Ace:
        break;
}

// Two constants in one statement, in a class, an interface, a trait, an enum and an anonymous class. A global const
// isn't checked, as section 4.3 is about classes, and a comma inside a value isn't a second constant.
const GLOBAL_A = 1, GLOBAL_B = 2;

class Several
{
    final public const int A = 1;
    final public const int B = 2;
    public const C = [1, 2];
    public const D = max(1, 2);
    public const E = [1, 2];
}

interface SeveralInterface
{
    public const A = 1;
    public const B = 2;
}

trait SeveralTrait
{
    public const A = 1;
    public const B = 2;
}

enum SeveralEnum
{
    public const A = 1;
    public const B = 2;
}

$several = new class {
    public const A = 1;
    public const B = 2;
};
