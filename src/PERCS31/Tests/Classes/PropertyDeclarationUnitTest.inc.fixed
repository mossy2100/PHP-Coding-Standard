<?php

// === VALID: Basic properties ===

class ValidBasicProperties
{
    public string $name = 'foo';

    protected int $age = 0;

    private array $items = [];

    public static int $count = 0;

    public readonly string $id = 'abc';
}

// === VALID: Property hooks (variables inside should NOT trigger errors) ===

class ValidHookProperties
{
    public string $arrowHook {
        get => 'value';
    }

    public string $blockHook {
        get {
            $temp = 'hello';
            return $temp;
        }
        set {
            $this->blockHook = $value;
        }
    }

    public string $withDefault = 'default' {
        get => $this->withDefault;
        set => $this->withDefault = $value;
    }

    public private(set) string $aviz = 'test';

    final public string $finalHook {
        get => 'final';
    }
}

abstract class ValidAbstractProperties
{
    abstract public string $abstractProp { get; set; }
}

// === ERRORS ===

class ErrorProperties
{
    // Underscore: error.
    public string $_underscored = 'bad';

    // VarUsed + ScopeMissing: 2 errors.
    var $oldStyle;

    // Multiple: no error, as Slevomat's DisallowMultiPropertyDefinition reports it.
    public $first, $second;

    // Spacing after the type: no error, as Slevomat's PropertyDeclaration reports it.
    public string$noSpace = '';

    // Spacing after the type: no error (Slevomat).
    public string  $twoSpaces = '';

    // Modifier order: no error, as Slevomat's PropertyDeclaration reports it.
    static public int $staticFirst = 0;

    // Modifier order: no error (Slevomat).
    readonly public string $readonlyFirst = 'a';

    // Modifier order: no error (Slevomat).
    protected(set) public string $avizWrong = '';

    // Modifier order: no error (Slevomat).
    public final string $finalAfter {
        get => '';
    }
}

abstract class ErrorAbstractProperties
{
    // Modifier order: no error (Slevomat).
    public abstract string $abstractAfter { get; set; }
}

class MoreProperties
{
    // Valid: a set hook with an explicit parameter.
    public string $explicit {
        set(string $value) {
            $this->explicit = trim($value);
        }
    }

    // Spacing after the type: no error (Slevomat).
    public string
        $splitType;

    // Spacing after the type: no error (Slevomat).
    public string  /* note */ $commented;

    // Valid: local variables and variables in strings are not properties.
    public function run(): string
    {
        $local = 'x';
        return "Value: $local";
    }
}

enum Status
{
    // Not reported: a property in an enum is a parse error, which getMemberProperties() rejects.
    public $invalid;
}

class PromotedProperties
{
    // Underscore: an error on each promoted parameter, but not on the plain one.
    public function __construct(
        public readonly int $_promoted,
        private string $_alsoPromoted,
        int $_notPromoted,
        public int $fine,
    ) {
    }
}

interface HookOrder
{
    // Valid.
    public string $getFirst { get; set; }

    // HookOrder: set before get.
    public string $setFirst { get; set; }

    // HookOrder: set before get, with &.
    public string $byReference { &get; set; }

    // HookOrder: set before get, with an attribute.
    public string $withAttribute { get; #[Pure] set; }
}

// Valid by default: a hook list with bodies, as PER only sets the order for an abstract or interface property.
class HookOrderWithBodiesDefault
{
    public string $notChecked {
        set => $value;
        get => 'x';
    }
}

// phpcs:set PERCS31.Classes.PropertyDeclaration orderHooksWithBodies true

abstract class HookOrderWithBodies
{
    // HookOrder: arrow hooks.
    public string $arrows {
        get => 'x';
        set => $value;
    }

    // HookOrder: block hooks, with a parameter list.
    public string $blocks {
        get {
            return $this->blocks;
        }
        set(string $value) {
            $this->blocks = $value;
        }
    }

    // HookOrder: a comment between the hooks (not fixable).
    public string $commented {
        set => $value; // Why.
        get => 'x';
    }

    // Valid.
    public string $ordered {
        get => 'x';
        set => $value;
    }
}

// ScopeMissing: promoted constructor parameters with no visibility. A set-visibility alone is allowed.
class PromotedVisibility
{
    public function __construct(
        readonly int $missing,
        final int $alsoMissing,
        #[Attr] readonly int $missingAfterAttribute,
        public readonly int $public,
        private(set) int $setOnly,
        protected readonly int $protected,
        int $notPromoted,
    ) {}
}
