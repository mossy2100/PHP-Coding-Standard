<?php // phpcs:disable PERCS31.Classes.TraitUseBlock.BlankLine

class Talker
{
    use Greeter {
        // Valid.
        sayHello as protected;
        sayBye as private myBye;
        sayHi as final;
        sayYo as final myYo;
        Greeter::wave as myWave;

        // Two spaces, and a line break, after the visibility.
        sayOne as private myOne;
        sayTwo as protected myTwo;

        // After final.
        sayThree as final myThree;

        // A comment in the way isn't fixed.
        sayFour as private /* Why. */  myFour;
    }
}

// An as elsewhere isn't a trait's.
foreach ($items as $key => $value) {
    echo $key, $value;
}

// A statement on the opening brace's line, and a closing brace on a statement's line.
class OneLineBlock
{
    use A, B {
        A::smallTalk insteadof B;
    }
}

// phpcs:enable PERCS31.Classes.TraitUseBlock.BlankLine -- Blank lines in a conflict block, which PERCS31 allows.
class BlankBlock
{
    use A, B {
        A::smallTalk insteadof B;
        B::bigTalk as talk;
    }
}

// Valid: one statement per line between the braces.
class ValidBlock
{
    use A, B {
        A::smallTalk insteadof B;
        B::bigTalk as talk;
    }
}

// Valid: a comment at the end of the last trait use's line, with the class's closing brace next.
class TrailingComment
{
    use A; // The first.
}

class TrailingBlockComment
{
    use A;
    use B; /* The second. */
}

class TrailingBlockCloserComment
{
    use A {
        A::smallTalk as talk;
    } // The block.
}

// No blank line after the last trait use when more follows, with or without a comment at the end of its line.
class NoBlankLine
{
    use A;

    public int $a = 1;
}

class NoBlankLineComment
{
    use A; // The first.

    public int $a = 1;
}

class CommentOnNextLine
{
    use A;

    // A comment of its own follows the use.
}

class SameLine
{
    use A;

    public int $a = 1;
}

// A blank line between two trait uses: after a statement, after a conflict block, and before a comment.
class BetweenUses
{
    use A;
    use B {
        B::smallTalk as talk;
    }
    use C;
    // The fourth.
    use D;
}

// Valid: a comment between two trait uses, with no blank line.
class CommentBetweenUses
{
    use A;
    // The second.
    use B;
}
