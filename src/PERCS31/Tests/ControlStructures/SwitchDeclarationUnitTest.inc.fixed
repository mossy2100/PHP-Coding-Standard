<?php

// === VALID ===

switch ($a) {
    case 1:
        foo();
        break;
    default:
        bar();
        break;
}

switch ($a) {
    case 1:
        return 1;
    case 2:
    case 3:
}

switch ($a) {
    case 1:
        if ($b) {
            return 1;
        } else {
            throw new Exception();
        }
}

switch ($a) {
    default:
        // Nothing to do.
}

switch (true) {
    case (
        $a
        && $b
    ):
        foo();
        break;
    case (
        $a
        && $b
    ):
        exit(1);
}

switch ($a) {
    case 1:
        switch ($b) {
            case 2:
                return 2;
        }

        break;
}

// === INVALID ===

switch ($a) {
    case 1:
        foo();
        break;
    default:
        bar();
        break;
}

switch ($a) {
    case 1:
        foo();
        break;
}

switch ($a) {
    case 1:
        if ($b) {
            return 1;
        }
        break;
}

switch ($a) {
    default:
        bar(); }

switch (true) {
    case (
        $a
        && $b
    ):
        foo();
        break;
    case (
        $a
        && $b
    ):
        foo();
        break;
    case (
        $a
        && $b
    ):
        foo();
        break;
    case $a
        && $b /* Both. */:
        foo();
        break;
    case (
        $a
        && $b /* Both. */):
        foo();
        break;
}

// === DEFAULT BEFORE ANOTHER CASE, VALID ===

switch ($a) {
    default:
    case 1:
        foo();
        break;
}

switch ($a) {
    default:
        bar();
        break;
    case 1:
        foo();
        break;
}

switch ($a) {
    default:
        return 1;
    case 1:
        foo();
        break;
}

switch ($a) {
    default:
        bar();
        // No break.
    case 1:
        foo();
        break;
}

switch ($a) {
    default:
        if ($b) {
            return 1;
        } else {
            return 2;
        }
    case 1:
        foo();
        break;
}

// === DEFAULT BEFORE ANOTHER CASE, INVALID ===

switch ($a) {
    default:
        bar();
    case 1:
        foo();
        break;
}

switch ($a) {
    case 1:
        foo();
        break;
    default:
        if ($b) {
            return 1;
        }
    case 2:
        foo();
        break;
}

switch ($a) {
    case 1:
        switch ($b) {
            default:
                bar();
            case 2:
                foo();
                break;
        }

        break;
}

// A split condition: the first condition on the next line, and each line indented.
switch ($a) {
    case (
        $b
        && $c
    ):
        break;
    case (
            $b
            && $c
    ):
        break;
    case ( // A comment.
        $b

        && $c
    ):
        break;
    case (
        // A comment.
        foo(
            1,
        )
    ):
        break;
    case (
        $b === 'x
y'
        && $c
    ):
        break;
    case ([
        1,
    ]
    ):
        break;
}

switch ($a) {
    case (
        $b
        && $c
    ):
        break;
    case (
        $b
        && $c
    ):
        break;
    case (/* A comment. */ $b
        && $c
    ):
        break;
    case (
        $b
        && $c
    ):
        break;
}

if ($a) {
    switch ($b) {
        case (
            $c
            && $d
        ):
            break;
    }
}
