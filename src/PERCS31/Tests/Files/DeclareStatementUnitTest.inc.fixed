<?php

// === VALID ===

declare(ticks=1,encoding='UTF-8');
declare(ticks=1);
declare(encoding='UTF-8');

// === INVALID ===

declare(ticks=1,encoding='UTF-8');
declare(ticks=1,encoding='UTF-8');
declare(ticks=1,encoding='UTF-8');
declare(ticks=1);
declare(encoding='UTF-8');

// Block declares, with several directives and a string value.
declare(ticks=1,encoding='UTF-8') {
    $a = 1;
}
declare(ticks=1,encoding='UTF-8') {
    $a = 1;
}
declare(encoding='UTF-8');

// No space before the brace, with one directive and with several, and the brace on the next line.
declare(ticks=1) {
    $a = 1;
}
declare(ticks=1,encoding='UTF-8') {
    $a = 1;
}
declare(ticks=1) {
    $a = 1;
}
