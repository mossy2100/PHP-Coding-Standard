<?php

// === VALID ===

$a = new class {
    public int $x = 1;
};

$b = foo(new class {
    public int $x = 1;
});

$c = (new class {
    public int $x = 1;
})->x;

$d = new class {
    public int $x = 1;
}; // phpcs:ignore Generic.Foo

$e = array_map(function ($v) {
    return $v;
}, $list); // A closure isn't a class.

$f = new class {}; $g = 1;

// A phpcs annotation and a closing tag are allowed after any brace.
function annotated(): void
{
    $m = 1;
} // phpcs:ignore Generic.Foo

function beforeTag(): void {} ?>
<?php

// An anonymous class's closing brace isn't checked, so a comment after it passes.

$h = new class {
    public int $x = 1;
}; // Comment.

$i = foo(new class {
    public int $x = 1;
}); // Comment.

$j = foo(
    new class {
        public int $x = 1;
    }, // Comment.
    2,
);

$k = new class {
    public int $x = 1;
} /* Comment */;

$l = new class {}; // Comment.
// === INVALID ===
final class Named
{
    public int $x = 1;
} // Comment.

final class WithMethod
{
    public function method(): void
    {
        $m = 1;
    } // Comment.
}

// A statement after a function's closing brace.
function named(): void
{
    $m = 1;
}
$n = 1;

function commented(): void
{
    $m = 1;
} // Comment.

// An empty statement, and a comment with a statement after it.
function checked(): void
{
    $m = 1;
};

function checkedComment(): void
{
    $m = 1;
} /* Comment. */ $n = 1;
// End of the functions.

// A property hook body or hook list.
class B
{
    public int $a {
        get {
            return 1;
        } // Body comment.
        set {
            $this->a = $value;
        }
    } // List comment.

    public int $b { get => 1; } // Short list comment.

    public int $c {
        get => 1; // Fine: after a semicolon, not a brace.
    }

    public int $d {
        get {
            return 1;
        } // phpcs:ignore Generic.Foo
    }

    public function __construct(
        public string $e { set => trim($value); }, // Promoted comment.
        public string $f { set => trim($value); },
    ) {}
}

// Code after a hook list's closing brace, and after a trait use block's.
class C
{
    use T { a as b; } // A comment is allowed here.

    use U { a as c; }
    public int $z = 1;

    public string $first {
        get => $this->first;
    }
    public int $second = 1;

    public string $commented {
        get => $this->commented;
    } /* Why. */ public int $fourth = 1;

    public int $g {
        get {
            return 1;
        } set {
            $this->g = $value;
        }
    }

    public function method(): void
    {
        $m = 1;
    }
    public function other(): void
    {
        $m = 1;
    }
}
