<?php

// === VALID ===

$someInstance
    ->create()
    ->prepare()
    ->run();

$a = $foo->bar()->baz();

$b = $this->repository
    ->findAll();

$c = Foo::create()
    ->run();

$d = $this->foo()->bar(
    1,
);

$app->get('/hello', function ($name) {
    return 'Hello';
})->name('hello');

$e = $f->g
    ->h;

// === INVALID ===

$x
    ->create()
    ->prepare()
    ->run();

$y = $this->em
    ->createQueryBuilder()
    ->select('a');

$z = $a
    ?->b()
    ?->c();

function f()
{
    return $this
        ->a()
        ->b();
}

foo($bar
    ->baz()
    ->qux());

// An operator at the end of a line: a statement's only one, its first, a later one, and one alone on its line.
$user = $repository
    ->find($id);

$someInstance
    ->create()
    ->prepare();

$result = $builder
    ->where('a')
    ->orderBy('b');

$value = $object
    ?->method();

// After a comment, it isn't fixed.
$user = $repository-> // Why.
    find($id);

// Two chains in one statement: a call on one line isn't part of the chain that's split after an operator.
$ok = $a->isValid()
    && $b
        ->check()
        ->passes();

$name = $user->isAdmin()
    ? 'admin'
    : $user
        ->profile()
        ->name();

$value = $this->cache->get($key)
    ?? $this->loader
        ->load($key)
        ->value();

// Brackets are part of a chain, so its first method is still found.
$item = $list
    ->all()[$index + 1]
    ->first();

// A chain's lines not indented, and indented too far.
$a
    ->b()
    ->c();

$a
    ->b()
    ->c();

// A chain in a ternary's branch, or after a wrapped operator, level with the line it starts on.
$x = $cond
    ? $a
        ->b()
        ->c()
    : $d;

$total = $base
    + $this->items
        ->sum('price');
