<?php

// A match arm's conditions split over lines.

// === VALID ===

$a = match ($x) {
    1,
    2, => 3,
    4,
    5,
        => 6,
    // A condition that spans lines splits the list.
    [
        7,
        8,
    ], => 9,
    10,
    [
        11,
    ], => 12,
    // A break before the => doesn't.
    13, 14
        => 15,
    default => 16,
};

// === INVALID ===

$b = match ($x) {
    1,
    2, => 3,
    4,
    5,
        => 6,
    7,
    8, // Why.
        => 9,
    foo(
        10,
    ), => 11,
    [
        12,
    ],
        => 13,
    13, 14
        => 15,
    default => 16,
};
