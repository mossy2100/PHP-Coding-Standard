<?php

// === VALID: an empty body on one line ===

function emptyFunction(): void {}

final class Holder
{
    public function __construct(private int $a) {}

    public function multi(
        int $a,
        int $b,
    ): void {}
}

$closure = static function (): void {};
$closureWithUse = static function () use ($a): void {};

// === INVALID: the parent's checks still run ===

function notEmpty(): int
{
    return 1;
}

function badMulti(
    int $a,
    int $b,
) {
    return;
}

// Arrow functions: a valid split parameter list, then the first parameter on the opening line, two parameters on one
// line, a double indent, and the closing parenthesis after the last parameter.
$valid = fn(
    int $a,
    int $b,
): int
    => $a + $b;
$firstSameLine = fn(
    int $a,
    int $b,
): int => $a + $b;
$twoPerLine = fn(
    int $a,
    int $b,
): int => $a + $b;
$doubleIndent = fn(
    int $a,
): int => $a;
$closeWithLast = fn(
    int $a,
    int $b
): int => $a + $b;

// A promoted parameter's multi-line hook list isn't indented as a parameter. PromotedPropertyHooks reports it.
class PromotedHookList
{
    public function __construct(
        public string $name {
            set {
                $this->name = ucfirst($value);
            }
        },
    ) {}
}

// A valid one-line hook is still checked.
class PromotedOneLineHook
{
    public function __construct(
        public string $name { set => ucfirst($value); },
        public string $other,
    ) {}
}

// A closure's use on the line after the closing parenthesis is joined to it. The parent's two fixes for it undo each
// other.
$joined = function (
    $longArgument,
    $longerArgument,
) use ($var1) {
    return 1;
};

$joined = function ($arg) use ($var1) {
    return 1;
};

// A comment in the way stops the fix.
$commented = function (
    $longArgument,
) // Why.
use ($var1) {
    return 1;
};
