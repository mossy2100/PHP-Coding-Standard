<?php

// === VALID ===

$total = (
    $price
        + $tax
        - $discount
);

// The first value is on the ( line, so the rest is indented once past that line.
$total = ($price
    + $tax);

// Nested in a call argument.
foo(
    (
        $a
            && $b
    ),
    $c,
);

foo(
    ($a
        && $b),
    $c,
);

// An index.
$value = $values[
    $a
        + $b
];

// An arrow function's => and body are indented once.
$callback = (
    fn(int $y): int
        => $y
);

$callback = (
    fn(int $y): int => $y
        + 1
);

$callback = (fn(int $y): int => $y
    + 1);

$total = (
    array_map(fn($y) => $y, $z)
        + $tax
);

// === INVALID ===

// Lined up with the group's first line.
$total = (
    $price
        + $tax
);

$total = (
    $price
        + $tax
);

$total = ($price
    + $tax);

$total = ($price
    + $tax);

foo(
    (
        $a
            && $b
    ),
    $c,
);

$value = $values[
    $a
        + $b
];

// An arrow function's => and body not indented.
$callback = (
    fn(int $y): int
        => $y
);

$callback = (
    fn(int $y): int => $y
        + 1
);
