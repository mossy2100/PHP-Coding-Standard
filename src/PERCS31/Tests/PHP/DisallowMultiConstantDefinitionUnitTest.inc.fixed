<?php

class Foo
{
    // === VALID: single constant per statement ===

    public const int A = 1;

    public const int B = 2;

    // Valid: comma inside a short array literal is not a constant separator.
    public const array SCORES = [42, 33, 12, 99];

    // Valid: comma inside a long-syntax array is not a constant separator.
    public const array SIZES = array(1, 2);

    // Valid: comma inside a closure's parameter list is not a constant separator (PHP 8.5+).
    public const Closure ADD = static function (int $a, int $b): int { return $a + $b; };

    // === ERRORS: multiple constants in one statement ===

    // DisallowedMultiConstantDefinition: basic multi-constant definition.
    public const int C = 1;
    public const int D = 2;

    // DisallowedMultiConstantDefinition: still detected after parentheses. The comma inside array(1, 2) must be
    // skipped, but the comma separating F must still be caught.
    public const array E = array(1, 2);
    public const array F = [3];

    // DisallowedMultiConstantDefinition: still detected after a short array literal.
    public const array G = [1, 2];
    public const array H = [3];

    // DisallowedMultiConstantDefinition: modifiers before the visibility, such as final, are kept.
    final public const int J = 1;
    final public const int K = 2;
}

// Valid: single file-scope (non-class) constant. T_CONST isn't class-specific, so this must also be checked.
const TOP_LEVEL_A = 1;

// DisallowedMultiConstantDefinition: multi-constant definition at file scope.
const TOP_LEVEL_B = 1;
const TOP_LEVEL_C = 2;

class Documented
{
    /**
     * DisallowedMultiConstantDefinition: the doc comment is copied to each constant.
     */
    public const int N = 1;
    /**
     * DisallowedMultiConstantDefinition: the doc comment is copied to each constant.
     */
    public const int O = 2;
}

// Valid: a file-scope constant initialised with a multi-argument new expression (PHP 8.1+).
const I = new Complex(0, 1);

// DisallowedMultiConstantDefinition: still detected after a multi-argument new expression at file scope.
const ONE = new Complex(1, 0);
const TWO = 2;
