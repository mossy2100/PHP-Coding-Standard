// A set hook's parameter type.
class HookParameterTypes
{
    public int|string|array $valid {
        set(
            int
            |string
            |array $value,
        ) => $value;
    }

    public int|string|float $twoOnLine {
        set(
            int
            |string
            |float $value,
        ) => $value;
    }

    public int $operators {
        set(int $value) {
            foo(
                $value
                | 1|2,
            );
        }
    }
}

// A type that starts with a DNF group, split with one union segment per line.
function firstGroup(
    (A&B)
    |(C&D)
    |null $x,
    (A&B)
    |C $y,
    (A&B&E)
    |C
    |D $z,
): (A&B)
    |C {}

class FirstGroup
{
    public const (B&C)
        |D Z = 1;

    public (B&C)
        |D $x;

    public (B&C)|null $d {
        set(
            (B&C)
            |null $value,
        ) => $value;
    }
}

// Two union segments on one line, the first or a later one.
function firstGroupTwoOnLine(
    (A&B)
    |(C&D)
    |null $x,
    (A&B)
    |(C&D)
    |null $y,
): void {}

// An intersection split inside the first group, or a later one.
function firstGroupSplit(
    (A&B)
    |C $x,
    C
    |(A&B) $y,
): void {}

// A return type split after a single-line parameter list passes, as each line has one type.
function splitReturnType(): int
    |string
{
    return 1;
}

// The fix lines a new break up with the symbols that already start a line.
class HalfSplit
{
    public static int
        |string
        |float $a;
}
