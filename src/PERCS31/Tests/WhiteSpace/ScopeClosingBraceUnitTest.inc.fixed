<?php

// === VALID: an empty body on one line ===

final class EmptyException extends Exception {}

function emptyFunction(): void {}

final class Holder
{
    public function __construct(private int $a) {}

    public function noop(): void {}
}

$closure = static function (): void {};
$closureWithUse = static function () use ($a): void {};

// === INVALID: the parent's checks still run ===

if (true) {
    echo 1; 
}

function notEmpty(): int
{
    return 1; 
}

function anonymous(): object
{
    return new class {};
}

// A control structure's empty body as {} is allowed too.
try {
    run();
} catch (Exception $e) {} finally {}

while (next($items)) {}

// A case has no braces, so it isn't checked, whatever the tokenizer takes for its closer.
switch ($a) {
    case 1:
        $b = foo() ?? throw new Exception();
        break;
    case 2:
        $b = foo() or exit(1);
        break;
    default:
        $b = $c ? throw new Exception() : 1;
        break;
}
