<?php

// === VALID: Standard indentation ===

class StandardIndent
{
    public string $name = 'foo';

    public function method(): string
    {
        if (true) {
            return 'yes';
        } else {
            return 'no';
        }
    }

    public function loops(): void
    {
        for ($i = 0; $i < 10; $i++) {
            echo $i;
        }

        foreach ([1, 2, 3] as $item) {
            echo $item;
        }

        while (false) {
            break;
        }
    }

    public function switchCase(): string
    {
        return match (true) {
            true => 'yes',
            false => 'no',
        };
    }
}

// === VALID: Property hooks with correct indentation ===

class ValidHookIndent
{
    public string $arrowHook {
        get => 'value';
    }

    public string $blockHook {
        get {
            return 'value';
        }
        set {
            $this->blockHook = $value;
        }
    }

    public string $complexHook {
        get {
            if (true) {
                return 'nested';
            }
            return 'default';
        }
        set {
            foreach (['a', 'b'] as $item) {
                echo $item;
            }
            $this->complexHook = $value;
        }
    }

    public string $withDefault = 'default' {
        get => $this->withDefault;
        set => $this->withDefault = $value;
    }

    public string $afterHooks = 'still correct';
}

// === ERRORS: Property hooks with wrong indentation ===

class ErrorHookIndent
{
    // Incorrect: hook body under-indented.
    public string $underIndent {
        get {
            return 'value';
        }
    }

    // Incorrect: code after hooks over-indented (exact check after closer).
    public string $afterHooksWrong = 'bad';
}

class ClosureInMethodWithTypedParameters
{
    // Correct: a typed parameter is not a property, so the closure body is not a property hook.
    public function run(Foo $foo, int $count): array
    {
        return array_map(
            static function (int $value) use ($count): int {
                return $value * $count;
            },
            $foo->values
        );
    }

    // Correct: a promoted constructor parameter with a hook.
    public function __construct(
        public string $name {
            set => trim($value);
        },
    ) {
    }
}

// Correct: an anonymous class with attributes, indented once from new (PER Coding Style 3.1, section 8).
$valid = new
    #[Attribute]
    class {
        public int $x = 1;
    };

// Incorrect: the class not indented from new, so its body and closing brace aren't either.
$invalid = new
    #[Attribute]
    class {
        public int $x = 1;
    };

// A match arm, valid.
$a = match ($x) {
    1 => 2,
    default => 3,
};

$b = match ($x) {
    1,
    2 => 3,
    default => 4,
};

$c = match ($x) {
    1 => foo(
        2,
        3,
    ),
    2 => [
        4,
        5,
    ],
    3 => static function () {
        return 6;
    },
    4 => $y
        + 7,
    default => match ($y) {
        1 => 2,
        default => 3,
    },
};

$d = foo(match ($x) {
    1 => 2,
    default => 3,
});

$e = foo(
    match ($x) {
        1 => 2,
        default => 3,
    },
);

$f = $y
    ?? match ($x) {
        1 => 2,
        default => 3,
    };

$g = match (true) {
    // A comment.
    $x > 1 => 2,

    /* Another. */
    default => 3,
};

$h = [
    'a' => match ($x) {
        1 => 2,
        default => 3,
    },
];

function f(int $x): int
{
    return match ($x) {
        1 => 2,
        default => 3,
    };
}

class C
{
    public int $p {
        get => match ($this->q) {
            1 => 2,
            default => 3,
        };
    }

    public function m(): int
    {
        return match ($this->q) {
            1 => 2,
            default => 3,
        };
    }
}

$i = match ($x) { 1 => 2, default => 3 };

$j = match (
    $x
) {
    1 => 2,
    default => 3,
};

// A match arm indented too far.
$k = match ($x) {
    1 => 2,
    default => 3,
};

$l = match ($x) {
    1 => 2,
    default => 3,
};

$m = match ($x) {
    1,
    2 => 3,
    default => 4,
};

$n = match ($x) {
    1 => match ($y) {
        1 => 2,
        default => 3,
    },
    default => 4,
};

function matchInFunction(int $x): int
{
    return match ($x) {
        1 => 2,
        default => 3,
    };
}
