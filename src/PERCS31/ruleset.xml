<?xml version="1.0"?>
<ruleset name="PERCS31">
    <description>PER Coding Style 3.1, built on PSR-12</description>

    <!-- ====== PSR-12 ====== -->

    <!-- PER Coding Style extends PSR-12 -->
    <rule ref="PSR12">
        <!-- Replaced by PERCS31 versions that support property hooks (PHP 8.4) -->
        <exclude name="PSR2.Classes.PropertyDeclaration"/>
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>
        <!-- Replaced by a PERCS31 version that allows { get; set; } on an abstract or interface property (4.10) -->
        <exclude name="Generic.Formatting.DisallowMultipleStatements"/>
        <!-- Replaced by PERCS31.Classes.ClassDeclaration.BlankLineAfterOpenBrace, which skips an anonymous class, as
             section 8 gives it the closure rules, which allow a blank line after the brace (2.3, 4.1, 8) -->
        <exclude name="PSR12.Classes.OpeningBraceSpace"/>
        <!-- Replaced by PERCS31 versions that allow an empty body as {} (4, 4.4, 7, 8) -->
        <exclude name="PSR2.Classes.ClassDeclaration"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace"/>
        <!-- Replaced by a PERCS31 version with the switch rules (5.2) -->
        <exclude name="PSR2.ControlStructures.SwitchDeclaration"/>
        <!-- Replaced by PERCS31.Formatting.AfterClosingBrace, which checks every closing brace (4) -->
        <exclude name="PSR12.Classes.ClosingBrace"/>
        <!-- Replaced by a PERCS31 version that also covers the pipe operator |> (6.2) -->
        <exclude name="PSR12.Operators.OperatorSpacing"/>
        <!-- Replaced by a PERCS31 version that allows PascalCase for an enum constant, and recommends it (9) -->
        <exclude name="Generic.NamingConventions.UpperCaseConstantName"/>
        <!-- Replaced, as a name with no lower-case letter isn't PascalCase (2.1) -->
        <exclude name="Squiz.Classes.ValidClassName"/>
        <!-- Replaced by a PERCS31 version that allows <?php declare(strict_types=1) ?> on the first line of a file with
             markup (3) -->
        <exclude name="PSR12.Files.FileHeader"/>
        <!-- Replaced by a PERCS31 version that accepts a declare statement with several directives (3) -->
        <exclude name="PSR12.Files.DeclareStatement"/>
        <!-- Replaced by a PERCS31 version without PSR-12's rules for a multi-line foreach or match (5.2, 5.5) -->
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing"/>
        <!-- Replaced by PERCS31.ControlStructures.ForEachSpacing, which allows a line break before or after as and =>
             (5.5) -->
        <exclude name="Squiz.ControlStructures.ForEachLoopDeclaration"/>
        <!-- Replaced by a PERCS31 version that also covers a set hook's parameter (4.5) -->
        <exclude name="PSR12.Functions.NullableTypeDeclaration"/>
        <!-- Replaced by a PERCS31 version that also checks a set hook's parameter type (2.5) -->
        <exclude name="Generic.PHP.LowerCaseType"/>
        <!-- Replaced by a PERCS31 version that also checks a property hook's name (2.5) -->
        <exclude name="Generic.PHP.LowerCaseKeyword"/>
        <!-- Covered by PERCS31.PHP.LowerCaseKeyword, which reports the same keywords (2.5) -->
        <exclude name="Squiz.ControlStructures.LowercaseDeclaration"/>
        <exclude name="Squiz.Functions.LowercaseFunctionKeywords"/>
        <!-- Replaced by PERCS31.ControlStructures.BodyOnNextLine, which allows an empty body as {} (5) -->
        <exclude name="Squiz.ControlStructures.ControlSignature.NewlineAfterOpenBrace"/>
        <!-- Covered by PERCS31.Classes.ClassDeclaration.CloseBraceAfterBody, which reports the same blank line before
             the class's closing brace (4.1, 4.2) -->
        <exclude name="PSR12.Traits.UseDeclaration.BlankLineAfterLastUse"/>
        <!-- Replaced by PERCS31.Classes.TraitUseBlock.NoBlankLineAfterUse, as this code takes a comment at the end of
             the last use statement's line for something after it, and its fix then loops (4.2) -->
        <exclude name="PSR12.Traits.UseDeclaration.NoBlankLineAfterUse"/>
        <!-- Replaced by PERCS31.Classes.TraitUseBlock's StatementOnOpenBraceLine and CloseBraceNotOnOwnLine, as these
             codes also report a blank line in a trait's conflict block, which nothing forbids (2.3, 4.2) -->
        <exclude name="PSR12.Traits.UseDeclaration.SpaceAfterOpeningBrace"/>
        <exclude name="PSR12.Traits.UseDeclaration.SpaceBeforeClosingBrace"/>
        <!-- Replaced by SlevomatCodingStandard.Classes.TraitUseDeclaration, which also reports several traits in a use
             statement with a { } block (4.2) -->
        <exclude name="PSR12.Traits.UseDeclaration.MultipleImport"/>
        <!-- A default value's = is a binary operator, so it needs at least one space, not exactly one (6.2). Checked by
             PERCS31.Operators.OperatorSpacing -->
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpaceBeforeEquals"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpaceAfterEquals"/>
        <!-- Replaced by PERCS31.Operators.UnaryOperatorSpacing, which reports a space after every reference &, and
             Generic.WhiteSpace.SpreadOperatorSpacingAfter, which reports one after every spread ..., not only a
             parameter's (4.5) -->
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpacingAfterReference"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpacingAfterVariadic"/>
        <!-- Replaced by a PERCS31 version that also checks clone(), and skips a set hook's parameter list (4.7) -->
        <exclude name="PSR2.Methods.FunctionCallSignature"/>
        <!-- Replaced by PERCS31.PHP.TypeCast, which also reports (double) and (binary) (2.5) -->
        <exclude name="PSR12.Keywords.ShortFormTypeKeywords"/>
        <!-- Replaced by Universal.WhiteSpace.CommaSpacing's codes for a call, which also report a comma on the line
             after a heredoc's closing marker, and one in an array or a match inside a call's parentheses (4.7, 11) -->
        <exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.SpaceBeforeComma"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.NoSpaceAfterComma"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.TooMuchSpaceAfterComma"/>
        <!-- Covered by PERCS31.Functions.FunctionCallLayout, which reports the same problems in an anonymous class's
             argument list (4.7, 8) -->
        <exclude name="PSR12.Classes.AnonClassDeclaration.SpaceAfterOpenBracket"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.SpaceBeforeCloseBracket"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.FirstParamSpacing"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.Indent"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.OneParamPerLine"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration.CloseBracketLine"/>
        <!-- Covered by PERCS31.Functions.MultiLineFunctionDeclaration, which reports the space after function and
             before the opening parenthesis, with a fix (4.4) -->
        <exclude name="Squiz.Functions.FunctionDeclaration"/>
    </rule>

    <!-- Visibility on every constant is a MUST (4.3), but PSR12.Properties.ConstantVisibility only gives a warning -->
    <rule ref="PSR12.Properties.ConstantVisibility.NotFound">
        <type>error</type>
    </rule>

    <!-- Wrapped && and || at the start of the line in a condition, not the end (5.1, 6.4) -->
    <rule ref="PSR12.ControlStructures.BooleanOperatorPlacement">
        <properties>
            <property name="allowOnly" value="first"/>
        </properties>
    </rule>

    <!-- ====== GENERAL (2) ====== -->

    <!-- A file is encoded in UTF-8 (2.1, PSR-1 2.2). PSR-12 includes Generic.Files.ByteOrderMark for the BOM -->
    <rule ref="PERCS31.Files.Encoding"/>

    <!-- Line length (2.3): a warning over 120 characters, no hard limit, and a severity 4 warning over 80, which phpcs
         only shows with warning-severity set to 4. The sniff has one warning limit, so 80 is its lineLimit, and 120 is
         its absoluteLineLimit, with that limit's error turned into a warning. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="80"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>
    <rule ref="Generic.Files.LineLength.MaxExceeded">
        <type>warning</type>
    </rule>
    <rule ref="Generic.Files.LineLength.TooLong">
        <severity>4</severity>
    </rule>

    <!-- One statement per line, allowing { get; set; } on an abstract or interface property (2.3, 4.10) -->
    <rule ref="PERCS31.Formatting.DisallowMultipleStatements"/>

    <!-- Indentation, including property hooks (2.4, 4.9) and an anonymous class with attributes (8). A comment's indent
         isn't checked, by the sniff's default, as PER has no rule for it. -->
    <rule ref="PERCS31.WhiteSpace.ScopeIndent"/>

    <!-- A line indented further than its scope, after a complete statement (2.4, 5) -->
    <rule ref="PERCS31.WhiteSpace.ConsistentIndent"/>

    <!-- Brace sniffs, extended to allow an empty body as {} (4, 4.4, 7, 8) -->
    <rule ref="PERCS31.Classes.ClassDeclaration">
        <!-- Replaced by the sniff's own InterfaceNotOnOwnLine check, which doesn't report an interface after a blank
             line (2.3, 4.1) -->
        <exclude name="PERCS31.Classes.ClassDeclaration.InterfaceSameLine"/>
        <exclude name="PERCS31.Classes.ClassDeclaration.ExtendsInterfaceSameLine"/>
    </rule>
    <rule ref="PERCS31.Functions.MultiLineFunctionDeclaration">
        <!-- A blank line before a parameter list's or a use list's closing parenthesis isn't forbidden (2.3, 4.5,
             7) -->
        <exclude name="PERCS31.Functions.MultiLineFunctionDeclaration.BlankLineBeforeCloseBracket"/>
        <!-- Replaced by the sniff's own BlankLine check, which allows a blank line between two items (2.3, 12.4) -->
        <exclude name="PERCS31.Functions.MultiLineFunctionDeclaration.EmptyLine"/>
        <!-- Replaced by the sniff's own ParameterIndent check, which leaves a default value wrapped at an operator to
             the sniffs for 6.4 -->
        <exclude name="PERCS31.Functions.MultiLineFunctionDeclaration.Indent"/>
    </rule>
    <rule ref="PERCS31.WhiteSpace.ScopeClosingBrace"/>

    <!-- An empty body as {}: a warning for a class or function (4, 4.4), an error for a closure or anonymous class
         (7, 8). A control structure's isn't checked, as section 5 has no rule for it. -->
    <rule ref="PERCS31.Formatting.EmptyBody"/>

    <!-- Keywords in lower case, including a property hook's get or set (2.5) -->
    <rule ref="PERCS31.PHP.LowerCaseKeyword"/>

    <!-- Keywords in lower case (2.5): ::class, and function and const in a use statement -->
    <rule ref="Universal.Constants.LowercaseClassResolutionKeyword"/>
    <rule ref="Universal.UseStatements.LowercaseFunctionConst"/>

    <!-- One space after use, function and const, and each side of as, in an import (3) -->
    <rule ref="Universal.UseStatements.KeywordSpacing"/>

    <!-- A warning for an acronym in capitals in a name, as it's RECOMMENDED to write it like a word (2.7) -->
    <rule ref="PERCS31.NamingConventions.AcronymCasing"/>

    <!-- Classes, interfaces, traits and enums in PascalCase, which needs a lower-case letter (PSR-1, 2.1, 4) -->
    <rule ref="PERCS31.NamingConventions.ValidClassName"/>

    <!-- ====== TYPES (2.5) ====== -->

    <!-- Types in lower case, including in a set hook's parameter and a backed enum's type (2.5, 9) -->
    <rule ref="PERCS31.PHP.LowerCaseType"/>

    <!-- The canonical form of a type in a cast: (bool), (int), (float) and (string), not (boolean), (integer), (double)
         or (binary) (2.5) -->
    <rule ref="PERCS31.PHP.TypeCast"/>

    <!-- No spaces inside the parentheses of a DNF type (2.5). The sniff's other properties are left unset, which turns
         their checks off. PERCS31.TypeHints.CompoundType checks the space around | and &, as it allows a type
         split before one. It also checks where null goes, and ?T, as it covers a type with an intersection, a typed
         constant and a set hook's parameter, and this sniff's ?T fix turns a static|null return type into ?, a parse
         error. -->
    <rule ref="SlevomatCodingStandard.TypeHints.DNFTypeHintFormat">
        <properties>
            <property name="withSpacesInsideParentheses" value="no"/>
        </properties>
    </rule>

    <!-- No space around | or & in a compound type, but a split before one allowed, including the | between a
         multi-catch's types. A compound type split across lines has one type, or one union segment, per line, each
         level with the type's first line, or indented once past it when other code comes before the type on that line
         (2.5). null last in a union, and a warning recommending ?T for a union of one type with null, as it's a
         SHOULD, everywhere a type can appear (2.5). -->
    <rule ref="PERCS31.TypeHints.CompoundType"/>

    <!-- No space after the ? of a nullable type, wherever a type can appear (4.5) -->
    <rule ref="PERCS31.Functions.NullableTypeDeclaration"/>

    <!-- ====== COMMAS (2.6) ====== -->

    <!-- Trailing commas: disallowed on single-line lists, required on multi-line ones (2.6) -->
    <!-- The PERCS31 version also disallows one after a single argument split over lines, as in foo([ ... ],);, as that
         doesn't split the argument list (4.7) -->
    <rule ref="PERCS31.Functions.DisallowTrailingCommaInCall"/>
    <rule ref="SlevomatCodingStandard.Functions.DisallowTrailingCommaInClosureUse">
        <properties>
            <property name="onlySingleLine" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.DisallowTrailingCommaInDeclaration">
        <properties>
            <property name="onlySingleLine" value="true"/>
        </properties>
    </rule>
    <!-- The PERCS31 version skips a first-class callable, where the Slevomat sniff's fix adds a comma after the ...,
         which is a parse error (4.8) -->
    <rule ref="PERCS31.Functions.RequireTrailingCommaInCall"/>
    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInClosureUse"/>
    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInDeclaration"/>

    <!-- A trailing comma after the last element of a multi-line array, keyed or not, including after a heredoc
         (2.6) -->
    <rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma"/>

    <!-- A trailing comma in a multi-line match, group use, list(), or the arguments of an anonymous class, clone(),
         exit(), die() or a call through an expression, as in $handlers[$name](, and none on a single line. The same
         for a match arm's conditions. Also no trailing comma hidden by a comment after it, on one line, in a
         parameter list, a closure's use list or an array (2.6). -->
    <rule ref="PERCS31.Formatting.TrailingComma"/>

    <!-- No trailing comma in an attribute block (2.6). 12.1 keeps #[ and ] on the attributes' own lines, and 12.3 puts
         split attributes in separate blocks, so a block's list is never split, even when an attribute's arguments are.
         The code that requires a comma in a multi-line block of several attributes is excluded, as 12.3 already
         rejects that block. -->
    <rule ref="Universal.Attributes.TrailingComma">
        <exclude name="Universal.Attributes.TrailingComma.RequiredMultiAttributeMultiLine"/>
    </rule>

    <!-- A comma with no space before it and one after in any other list, such as an array, group use, match
         conditions or clone(), as the examples show (3, 5.2, 11). The codes ending in InFunctionCall cover a comma
         inside a call's parentheses (4.7). Parameter, closure use and declare lists have their own codes, which other
         sniffs already cover. -->
    <rule ref="Universal.WhiteSpace.CommaSpacing.SpaceBefore"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.SpaceBeforeInFunctionCall"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.NoSpaceAfterInFunctionCall"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.TooMuchSpaceAfterInFunctionCall"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.NoSpaceAfter"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.TooMuchSpaceAfter"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.CommaAfterComment"/>

    <!-- ====== FILES (3) ====== -->

    <!-- The <?php tag in lower case (3) -->
    <rule ref="Universal.PHP.LowercasePHPTag"/>

    <!-- The file header (3), allowing a declare statement between PHP tags on the first line of a file with markup -->
    <rule ref="PERCS31.Files.FileHeader"/>

    <!-- A group use split across lines: one name per line, indented once, the first on the line after the {, and the }
         on a line of its own, as the examples in 3 show. No blank line in it, as a header block can't contain one
         (3). -->
    <rule ref="PERCS31.Namespaces.GroupUseLayout"/>

    <!-- No spaces inside a declare statement's parentheses, including one with several directives (3) -->
    <rule ref="PERCS31.Files.DeclareStatement"/>

    <!-- ====== CLASSES, PROPERTIES AND CONSTANTS (4) ====== -->

    <!-- No statement after any closing brace, and no comment after a class's, method's, function's or property hook's
         (4, 2.3) -->
    <rule ref="PERCS31.Formatting.AfterClosingBrace"/>

    <!-- A warning for new Foo() wrapped in parentheses before ->, ?-> or ::, and an argument list after
         new (expression), which PSR12.Classes.ClassInstantiation misses (4) -->
    <rule ref="PERCS31.Classes.ClassInstantiationParentheses"/>

    <!-- One trait per use statement, including one with a { } block, as in use A, B { ... } (4.2) -->
    <rule ref="SlevomatCodingStandard.Classes.TraitUseDeclaration"/>

    <!-- The { } block of a trait use: one space after a visibility or final in an as clause, as in
         sayBye as private myBye;, no statement on the opening brace's line, and the closing brace on a line of its
         own (4.2). PSR12.Traits.UseDeclaration checks the space each side of as and insteadof. -->
    <rule ref="PERCS31.Classes.TraitUseBlock">
        <!-- A blank line in a trait's conflict block isn't forbidden, as only 4.2's example shows none (2.3) -->
        <exclude name="PERCS31.Classes.TraitUseBlock.BlankLine"/>
        <!-- A blank line between two trait use statements isn't forbidden, as 4.2 only requires one after the last
             (2.3) -->
        <exclude name="PERCS31.Classes.TraitUseBlock.BlankLineBetweenUses"/>
    </rule>

    <!-- abstract or final before readonly on a class (4.6) -->
    <rule ref="SlevomatCodingStandard.Classes.ClassKeywordOrder"/>

    <!-- final before the visibility on a constant, the order 4.6 sets for modifier keywords -->
    <rule ref="Universal.Constants.ModifierKeywordOrder"/>

    <!-- One constant per class constant statement, through Slevomat's DisallowMultiConstantDefinition, and one space
         after its const keyword and between its type and its name (4.3, 4.6). One space after an enum case's case
         keyword (9). -->
    <rule ref="PERCS31.Classes.ConstantDeclaration"/>

    <!-- No leading underscore on a constant (4.3) -->
    <rule ref="PERCS31.NamingConventions.ValidConstantName"/>

    <!-- Class constants in UPPER_CASE (PSR-1), except in an enum, where a warning recommends PascalCase (9) -->
    <rule ref="PERCS31.NamingConventions.UpperCaseConstantName"/>

    <!-- One property per statement (4.3) -->
    <rule ref="SlevomatCodingStandard.Classes.DisallowMultiPropertyDefinition"/>

    <!-- Property modifier order, and the spacing around them and the type (4.3, 4.6) -->
    <rule ref="SlevomatCodingStandard.Classes.PropertyDeclaration">
        <!-- A space after the ? of a nullable type is reported by PERCS31.Functions.NullableTypeDeclaration -->
        <exclude name="SlevomatCodingStandard.Classes.PropertyDeclaration.WhitespaceAfterNullabilitySymbol"/>
        <properties>
            <property name="checkPromoted" value="true"/>
        </properties>
    </rule>

    <!-- Properties: no leading underscore, no var, and a visibility (4.3) -->
    <rule ref="PERCS31.Classes.PropertyDeclaration">
        <!-- Several properties in one statement are checked by
             SlevomatCodingStandard.Classes.DisallowMultiPropertyDefinition. The parent's check also reports every
             property with hooks, as it reads the hook list as a second property, so this code must stay excluded. -->
        <exclude name="PERCS31.Classes.PropertyDeclaration.Multiple"/>
        <!-- Modifier order and the spacing after the type are checked by
             SlevomatCodingStandard.Classes.PropertyDeclaration -->
        <exclude name="PERCS31.Classes.PropertyDeclaration.SpacingAfterType"/>
        <exclude name="PERCS31.Classes.PropertyDeclaration.StaticBeforeVisibility"/>
        <exclude name="PERCS31.Classes.PropertyDeclaration.ReadonlyBeforeVisibility"/>
        <exclude name="PERCS31.Classes.PropertyDeclaration.FinalAfterVisibility"/>
        <exclude name="PERCS31.Classes.PropertyDeclaration.AbstractAfterVisibility"/>
        <exclude name="PERCS31.Classes.PropertyDeclaration.AvizKeywordOrder"/>
        <!-- The parent's warning for a leading underscore can't skip a double one, so the sniff's LeadingUnderscore
             error replaces it (4.3) -->
        <exclude name="PERCS31.Classes.PropertyDeclaration.Underscore"/>
    </rule>

    <!-- The layout of a property's hook list: its braces, a short hook's =>, and get before set (4.9, 4.10). One space
         before a hook's own {, and a set hook's parameter list spaced like a method's, as the examples in 4.9 show. A
         hook on a promoted constructor parameter only as a single short hook on one line (4.9). -->
    <rule ref="PERCS31.Classes.PropertyHooks"/>

    <!-- ====== FUNCTIONS AND CALLS (4.7) ====== -->

    <!-- No space before a named argument's colon, one after (4.7) -->
    <rule ref="SlevomatCodingStandard.Functions.NamedArgumentSpacing"/>

    <!-- A method chain split across lines: each object operator starts a line, indented once past the line the chain
         starts on, and the first method is on the next line (4.7) -->
    <rule ref="PERCS31.Formatting.MethodChaining"/>

    <!-- exit() and die() with parentheses; a warning, as 4.7 says SHOULD -->
    <rule ref="Universal.PHP.RequireExitDieParentheses">
        <type>warning</type>
    </rule>

    <!-- A warning for clone without parentheses, e.g. clone $a, or with parentheses that hold only part of what is
         cloned, e.g. clone($a)->b (4.7) -->
    <rule ref="PERCS31.PHP.RequireCloneParentheses"/>

    <!-- A call's argument list, including clone()'s, but not a set hook's parameter list (4.7). The parent's EmptyLine
         is replaced by the sniff's own BlankLine check, which allows a blank line between two arguments (2.3). PSR-12
         turns off the parent's SpaceAfterCloseBracket and OpeningIndent codes. -->
    <rule ref="PERCS31.Functions.FunctionCallLayout">
        <!-- A blank line before an argument list's closing parenthesis isn't forbidden (2.3, 4.7) -->
        <exclude name="PERCS31.Functions.FunctionCallLayout.BlankLineBeforeCloseBracket"/>
        <exclude name="PERCS31.Functions.FunctionCallLayout.EmptyLine"/>
        <exclude name="PERCS31.Functions.FunctionCallLayout.SpaceAfterCloseBracket"/>
        <exclude name="PERCS31.Functions.FunctionCallLayout.OpeningIndent"/>
    </rule>

    <!-- A first-class callable written as (...), with no white space or line break inside (4.8) -->
    <rule ref="Universal.WhiteSpace.FirstClassCallableSpacing"/>

    <!-- ====== CONTROL STRUCTURES (5) ====== -->

    <!-- A structure's body in braces, not the alternative syntax, e.g. if (): ... endif; (5) -->
    <rule ref="Universal.ControlStructures.DisallowAlternativeSyntax"/>

    <!-- Braces on a structure with no body, as in while (next($items)) {}, not while (next($items)); (5) -->
    <rule ref="PERCS31.ControlStructures.ControlStructureEmptyStatement"/>

    <!-- A structure's body on the line after its opening brace, allowing an empty body as {} (5) -->
    <rule ref="PERCS31.ControlStructures.BodyOnNextLine"/>

    <!-- A control structure's parentheses, without PSR-12's rules for a multi-line foreach or match (5, 5.2, 5.5) -->
    <rule ref="PERCS31.ControlStructures.ControlStructureSpacing">
        <!-- Replaced by the sniff's own CloseParenthesisNotOnOwnLine check, as the parent's code also reports a blank
             line before a split header's closing parenthesis -->
        <exclude name="PERCS31.ControlStructures.ControlStructureSpacing.CloseParenthesisLine"/>
        <!-- A blank line before a split header's closing parenthesis isn't forbidden, as 5.1 to 5.4 only put the ) and
             the { together on their own line (2.3) -->
        <exclude name="PERCS31.ControlStructures.ControlStructureSpacing.BlankLineBeforeCloseParenthesis"/>
    </rule>

    <!-- One space between a catch's type and its variable, as the example in 5.6 shows -->
    <rule ref="PERCS31.ControlStructures.CatchVariableSpacing"/>

    <!-- One space, or a line break, before and after a foreach's as and => (5.5) -->
    <rule ref="PERCS31.ControlStructures.ForEachSpacing"/>

    <!-- switch rules, including a terminating statement in the last case, and parentheses around a multi-line case
         condition (5.2) -->
    <rule ref="PERCS31.ControlStructures.SwitchDeclaration">
        <!-- Replaced by the sniff's own StatementOnLabelLine check. The parent's codes also report a blank line after a
             label, which isn't forbidden (2.3, 5.2) -->
        <exclude name="PERCS31.ControlStructures.SwitchDeclaration.BodyOnNextLineCASE"/>
        <exclude name="PERCS31.ControlStructures.SwitchDeclaration.BodyOnNextLineDEFAULT"/>
        <!-- Covered by PERCS31.PHP.LowerCaseKeyword, which reports the same keywords (2.5) -->
        <exclude name="PERCS31.ControlStructures.SwitchDeclaration.caseNotLower"/>
        <exclude name="PERCS31.ControlStructures.SwitchDeclaration.defaultNotLower"/>
        <!-- Reported on a throw or exit expression in a case, as in $a ?? throw $e, which PHP_CodeSniffer takes for
             the case's terminating statement. A terminating statement that shares a line is still reported, by
             BodyOnNextLine, PERCS31.Formatting.DisallowMultipleStatements or PERCS31.Formatting.AfterClosingBrace. -->
        <exclude name="PERCS31.ControlStructures.SwitchDeclaration.BreakNotNewLine"/>
    </rule>

    <!-- Each match arm on a new line, as in the example in 5.2, and each condition of an arm on a line of its own when
         the arm's conditions are split over lines -->
    <rule ref="PERCS31.ControlStructures.MatchArmPlacement"/>

    <!-- At least one space around => in a match arm and an array, as in the examples in 5.2 and 11, which are too
         little to rule out lining arrows up. The same for a yield's =>, which PER leaves undefined, for
         consistency. -->
    <rule ref="PERCS31.WhiteSpace.ArrowSpacing"/>

    <!-- ====== OPERATORS (6) ====== -->

    <!-- Exactly one space after a cast (6.1) -->
    <rule ref="Generic.Formatting.SpaceAfterCast"/>

    <!-- At least one space around binary operators, including |> (6.2). The codes for more than one space are
         excluded, as PER allows more. -->
    <rule ref="PERCS31.Operators.OperatorSpacing">
        <exclude name="PERCS31.Operators.OperatorSpacing.SpacingBefore"/>
        <exclude name="PERCS31.Operators.OperatorSpacing.SpacingAfter"/>
        <exclude name="PERCS31.Operators.OperatorSpacing.SpacingBeforeAmp"/>
        <exclude name="PERCS31.Operators.OperatorSpacing.SpacingAfterAmp"/>
    </rule>

    <!-- No white space after a reference &, wherever it's used: a parameter, an assignment, a foreach, an array, a
         closure's use list, a function that returns by reference and a by-reference hook. 4.5 states the rule for a
         parameter, and it's read as the rule for the operator. The sniff's checks for +, -, !, ~ and @ are off by
         default, as section 6 leaves those undefined. -->
    <rule ref="PERCS31.Operators.UnaryOperatorSpacing"/>

    <!-- No white space after a spread ..., wherever it's used: a variadic parameter, a call's arguments and an array.
         4.5 states the rule for a parameter, and it's read as the rule for the operator. A first-class callable's ...
         isn't a spread, and is skipped (4.8). -->
    <rule ref="Generic.WhiteSpace.SpreadOperatorSpacingAfter"/>

    <!-- No white space around ->, ?-> and ::, except a line break before -> or ?-> in a split chain, as every
         example writes them (4.2, 4.7, 9) -->
    <rule ref="PERCS31.WhiteSpace.ObjectOperatorSpacing"/>

    <!-- A wrapped . at the start of the line, not the end (6.4) -->
    <rule ref="Universal.Operators.ConcatPosition"/>

    <!-- Any other wrapped binary operator, and an arrow function's =>, at the start of the line (6.4, 7.1). A ternary
         split at ? or : takes three lines, with ? and : leading, indented once (6.4). -->
    <rule ref="PERCS31.Operators.OperatorPlacement"/>

    <!-- ====== CLOSURES AND ANONYMOUS CLASSES (7, 8) ====== -->

    <!-- No space after fn, and the expression may be on the next line (7.1) -->
    <rule ref="SlevomatCodingStandard.Functions.ArrowFunctionDeclaration">
        <properties>
            <property name="spacesCountAfterKeyword" value="0"/>
            <property name="allowMultiLine" value="true"/>
        </properties>
    </rule>

    <!-- No space before the semicolon that ends an arrow function, no line break after fn, and no blank line before a
         wrapped => (7.1) -->
    <rule ref="PERCS31.Functions.ArrowFunctionSpacing"/>

    <!-- No () on an anonymous class without arguments (8) -->
    <rule ref="Universal.Classes.DisallowAnonClassParentheses"/>

    <!-- One space before an anonymous class's opening brace on the declaration's line, and nothing after the brace, as
         the examples in 8 show. The brace may be on the next line, so the parent's code for that is excluded. Also a
         space between its arguments and extends or implements, as in new class ($a) extends Foo (8). -->
    <rule ref="PERCS31.Classes.AnonClassLayout">
        <exclude name="PERCS31.Classes.AnonClassLayout.BraceOnNewLine"/>
    </rule>

    <!-- ====== ENUMS (9) ====== -->

    <!-- No space before a backed enum's colon (9). One after it is checked by PERCS31.Classes.ClassDeclaration, as the
         parent reads the type like an interface name. -->
    <rule ref="SlevomatCodingStandard.Classes.BackedEnumTypeSpacing">
        <exclude name="SlevomatCodingStandard.Classes.BackedEnumTypeSpacing.IncorrectSpacesBeforeType"/>
    </rule>

    <!-- Enum cases in PascalCase (9) -->
    <rule ref="PERCS31.NamingConventions.ValidEnumCaseName"/>

    <!-- private, not protected, for a non-public method or constant in an enum (9) -->
    <rule ref="PERCS31.Classes.EnumMemberVisibility"/>

    <!-- ====== HEREDOC AND NOWDOC (10) ====== -->

    <!-- A heredoc or nowdoc begins on its context's line, and its body and closing marker are indented once past that
         line (10) -->
    <rule ref="PERCS31.Strings.HeredocLayout"/>

    <!-- A warning for a heredoc that could be a nowdoc (10) -->
    <rule ref="Generic.Strings.UnnecessaryHeredoc"/>

    <!-- ====== ARRAYS (11) ====== -->

    <!-- Short array syntax, and the elements of a multi-line array indented once (11) -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.Arrays.ArrayIndent"/>

    <!-- A multi-line array: the first value on the next line, one value per line, and the closing bracket on the next
         line after the last value (11); no trailing comma on a single line (2.6). The other checks aren't PER
         rules. -->
    <rule ref="Squiz.Arrays.ArrayDeclaration">
        <exclude name="Squiz.Arrays.ArrayDeclaration.KeyNotAligned"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.ValueNotAligned"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.CloseBraceNotAligned"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.DoubleArrowNotAligned"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.SingleLineNotAllowed"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.MultiLineNotAllowed"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.NoSpaceBeforeDoubleArrow"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.SpaceBeforeDoubleArrow"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.NoSpaceAfterDoubleArrow"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.SpaceAfterDoubleArrow"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.NoSpaceAfterComma"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.SpaceAfterComma"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.SpaceBeforeComma"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.KeySpecified"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.NoKeySpecified"/>
        <!-- Covered by PERCS31.PHP.LowerCaseKeyword, which reports the same keyword (2.5) -->
        <exclude name="Squiz.Arrays.ArrayDeclaration.NotLowerCase"/>
        <!-- Where an element's comma goes isn't a PER rule, and this check gets a heredoc element wrong. Jumbo uses
             Jumbo.Arrays.ElementComma instead. -->
        <exclude name="Squiz.Arrays.ArrayDeclaration.NoComma"/>
        <!-- A multi-line array's trailing comma is checked by SlevomatCodingStandard.Arrays.TrailingArrayComma -->
        <exclude name="Squiz.Arrays.ArrayDeclaration.NoCommaAfterLast"/>
        <!-- A closing bracket not on a new line is reported by Generic.Arrays.ArrayIndent -->
        <exclude name="Squiz.Arrays.ArrayDeclaration.CloseBraceNewLine"/>
        <!-- Replaced by PERCS31.Arrays.MultiLineArrayLayout, as it reads an attribute on a value as an earlier
             value -->
        <exclude name="Squiz.Arrays.ArrayDeclaration.ValueNoNewline"/>
    </rule>

    <!-- No space inside a single-line array's brackets, as the example in 11 shows. An empty array's are checked by
         Squiz.Arrays.ArrayDeclaration.SpaceInEmptyArray, above, which also reports a line break in one. Its comma
         checks are left to Universal.WhiteSpace.CommaSpacing, which also covers an array nested in a multi-line
         one. -->
    <rule ref="SlevomatCodingStandard.Arrays.SingleLineArrayWhitespace">
        <exclude name="SlevomatCodingStandard.Arrays.SingleLineArrayWhitespace.SpaceBeforeComma"/>
        <exclude name="SlevomatCodingStandard.Arrays.SingleLineArrayWhitespace.SpaceAfterComma"/>
    </rule>

    <!-- A multi-line array's [ not on a line of its own, except as an element of a multi-line array, an argument, a
         match arm's condition, the first condition of a split if, elseif, while, switch or for, or a destructuring
         assignment. One value per line, the first on the next line, in a multi-line array whose values don't all have
         keys. One whose values all have keys is checked by Squiz.Arrays.ArrayDeclaration, above (11). -->
    <rule ref="PERCS31.Arrays.MultiLineArrayLayout"/>

    <!-- No blank line after a multi-line array's opening bracket, or before its closing bracket (11) -->
    <rule ref="PERCS31.Arrays.ArrayBracketSpacing"/>

    <!-- ====== ATTRIBUTES (12) ====== -->

    <!-- No () on an attribute without arguments (12.1) -->
    <rule ref="Universal.Attributes.DisallowAttributeParentheses"/>

    <!-- No space after #[ or before ] (12.1) -->
    <rule ref="Universal.Attributes.BracketSpacing"/>

    <!-- A doc comment before the attributes, not after (12.2) -->
    <rule ref="SlevomatCodingStandard.Attributes.RequireAttributeAfterDocComment"/>

    <!-- An attribute on its own line, before its target, except on a parameter in a single-line list, with no blank
         line or comment between them, and the layout of an anonymous class's attributes (8, 12.2). Several attributes
         may share a block on one line, but not one split over lines (12.3). -->
    <rule ref="PERCS31.Attributes.AttributeLayout"/>

    <!-- Separate attribute blocks on separate lines, except in a single-line parameter or argument list (12.2) -->
    <rule ref="PERCS31.Attributes.DisallowMultipleAttributesPerLine"/>

    <!-- A comma in an attribute block with no space before it and one after (12.3) -->
    <rule ref="Universal.WhiteSpace.CommaSpacing.SpaceBeforeInAttributeBlock"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.NoSpaceAfterInAttributeBlock"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing.TooMuchSpaceAfterInAttributeBlock"/>

</ruleset>
